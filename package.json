{
	"name": "right",
	"productName": "Right",
	"version": "1.0.0",
	"description": "Focused Writing.",
	"main": ".vite/build/main/main.js",
	"type": "module",
	"scripts": {
		"start": "electron-forge start",
		"package": "electron-forge package",
		"make:mac": "electron-forge package --arch=x64 --platform=darwin",
		"make": "electron-forge make",
		"publish": "electron-forge publish",
		"dev": "vite -c vite/vite.renderer.config.ts",
		"svelte-build": "vite build -c vite/vite.renderer.config.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest"
	},
	"devDependencies": {
		"@electron-forge/cli": "^7.5.0",
		"@electron-forge/maker-deb": "^7.5.0",
		"@electron-forge/maker-dmg": "^7.5.0",
		"@electron-forge/maker-rpm": "^7.5.0",
		"@electron-forge/maker-squirrel": "^7.5.0",
		"@electron-forge/maker-zip": "^7.5.0",
		"@electron-forge/plugin-auto-unpack-natives": "^7.5.0",
		"@electron-forge/plugin-fuses": "^7.5.0",
		"@electron/fuses": "^1.8.0",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
		"@types/electron-squirrel-startup": "^1.0.2",
		"@types/uuid": "^10.0.0",
		"autoprefixer": "^10.4.20",
		"electron": "32.1.2",
		"globals": "^15.0.0",
		"postcss": "^8.4.41",
		"postcss-import": "^16.1.0",
		"svelte": "^5.0.0-next.1",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.10",
		"ts-node": "^10.9.2",
		"typescript": "^5.0.0",
		"vite": "^5.4.8",
		"vitest": "^2.0.0"
	},
	"keywords": [],
	"license": "MIT",
	"dependencies": {
		"@svelte-plugins/tooltips": "^3.0.1",
		"@types/javascript-time-ago": "^2.0.8",
		"dexie": "^4.0.8",
		"dotenv": "^16.4.5",
		"electron-log": "^5.2.0",
		"electron-squirrel-startup": "^1.0.1",
		"electron-window-state": "^5.0.3",
		"javascript-time-ago": "^2.5.11",
		"uuid": "^10.0.0"
	}
